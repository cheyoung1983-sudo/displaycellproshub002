# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AWS Aurora PostgreSQL Configuration
AWS_ACCOUNT_ID="595710543826"
AWS_REGION="us-east-1"
AWS_RESOURCE_ARN="arn:aws:rds:us-east-1:595710543826:cluster:dcp-production-db"
AWS_ROLE_ARN="arn:aws:iam::595710543826:role/Vercel/access-dcp-production-db"
PGDATABASE="postgres"
PGHOST="dcp-production-db.cluster-cs7wcksg2js1.us-east-1.rds.amazonaws.com"
